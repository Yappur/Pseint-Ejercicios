Algoritmo Ejercicio_practico_bucle_para
	
	Definir suma, numeroASumar, iteracion Como Entero
	
	suma <- 0
	
	Para iteracion <- 1 Hasta 10 Hacer
		Escribir Sin Saltar "Ingrese el numero a sumar: "
		leer numeroASumar
		suma <- suma + numeroASumar
	FinPara
	
	Escribir suma
	Escribir "Se completo el ciclo"
	
FinAlgoritmo
